# Telegram Bot Token dari @BotFather
# Get: Open Telegram → search @BotFather → /newbot → copy token
BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key
# Get: https://console.anthropic.com/account/keys → Create Key → copy
CLAUDE_API_KEY=your_anthropic_api_key_here

# Local Development Port
PORT=3000

# Railway Webhook URL (auto-set saat deploy, jangan edit manual)
WEBHOOK_URL=

# Environment
NODE_ENV=development

